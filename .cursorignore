# Generated outputs. Indexing or reading these locks Kotlin and Java
# compiler caches on Windows and crashes the editor. Build scripts stay visible.

/build/
**/build/
.dart_tool/
.gradle/
**/.gradle/
**/.kotlin/
**/*.tab
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
.packages

android/.gradle/
android/captures/
android/.cxx/
**/.cxx/
**/.plugin_symlinks/
**/.symlinks/
ios/Pods/
macos/Pods/
**/Flutter/ephemeral/

# Java, Maven, Eclipse, and IntelliJ outputs. Source and build scripts stay visible.
target/
**/target/
out/
**/out/
bin/
**/bin/
.metadata/
**/.metadata/
.recommenders/
**/.recommenders/
.apt_generated/
**/.apt_generated/
.apt_generated_tests/
**/.apt_generated_tests/
*.class
*.war
*.ear

*.dill
*.apk
